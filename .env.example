# ------------------------------------------------------------------
# Nexo Assist — copie para .env e preencha a chave do modelo.
# ------------------------------------------------------------------

# --- Modelo (100% gratuito por padrão) ---
# Principal: Gemini 2.5 Flash — chave grátis, sem cartão: https://aistudio.google.com/apikey
LLM_MODEL=google/gemini-2.5-flash
GOOGLE_GENERATIVE_AI_API_KEY=

# Reserva automática (opcional, também gratuita): assume quando o Gemini
# estoura a cota (429), falha ou demora. Chave grátis: https://console.groq.com/keys
LLM_FALLBACK_MODEL=groq/openai/gpt-oss-120b
GROQ_API_KEY=

# Outros provedores (pagos) funcionam trocando LLM_MODEL, ex.:
# LLM_MODEL=openai/gpt-4.1-mini   + OPENAI_API_KEY=

# Local, sem chave (Ollama). Modelos de 7–8B têm qualidade limitada:
# LLM_MODEL=ollama/qwen2.5:7b
# LLM_BASE_URL=http://localhost:11434/v1

LLM_MAX_STEPS=6
LLM_HISTORY_WINDOW=14
# Abaixo desta confiança o agent transfere para um analista.
AGENT_MIN_CONFIDENCE=0.5

# --- API ---
API_PORT=4000
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-um-segredo-com-pelo-menos-32-caracteres
RATE_LIMIT_MESSAGES_PER_MINUTE=12

# --- Sistema de chamados simulado (legado) ---
HELPDESK_PORT=4001
HELPDESK_URL=http://127.0.0.1:4001
HELPDESK_SERVICE_TOKEN=troque-este-token-de-servico
# Simula a instabilidade do legado: 10% das chamadas respondem 503.
HELPDESK_FAILURE_RATE=0.1
HELPDESK_MAX_LATENCY_MS=250
HELPDESK_TIMEOUT_MS=2500
HELPDESK_RETRIES=3
