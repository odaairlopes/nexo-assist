# ------------------------------------------------------------------
# Nexo Assist — copie para .env e preencha a chave do modelo.
# ------------------------------------------------------------------

# --- Modelo (100% gratuito por padrão) ---
# Principal: gpt-oss-120b no Groq — chave grátis, sem cartão: https://console.groq.com/keys
LLM_MODEL=groq/openai/gpt-oss-120b
GROQ_API_KEY=

# Reserva automática (gratuita, mesma chave do Groq, cota diária separada):
# assume na hora quando o principal estoura a cota (429), falha ou demora.
LLM_FALLBACK_MODEL=groq/qwen/qwen3.8-27b

# Alternativa de reserva em outro provedor (mais lenta no plano gratuito):
# LLM_FALLBACK_MODEL=google/gemini-3.5-flash-lite
GOOGLE_GENERATIVE_AI_API_KEY=

# Outros provedores (pagos) funcionam trocando LLM_MODEL, ex.:
# LLM_MODEL=openai/gpt-4.1-mini   + OPENAI_API_KEY=

# Local, sem chave (Ollama). Modelos de 7–8B têm qualidade limitada:
# LLM_MODEL=ollama/qwen2.5:7b
# LLM_BASE_URL=http://localhost:11434/v1

LLM_MAX_STEPS=6
LLM_HISTORY_WINDOW=10
# Abaixo desta confiança o agent transfere para um analista.
AGENT_MIN_CONFIDENCE=0.5

# --- API ---
API_PORT=4000
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-um-segredo-com-pelo-menos-32-caracteres
RATE_LIMIT_MESSAGES_PER_MINUTE=12

# --- Sistema de chamados simulado (legado) ---
HELPDESK_PORT=4001
HELPDESK_URL=http://127.0.0.1:4001
HELPDESK_SERVICE_TOKEN=troque-este-token-de-servico
# Simula a instabilidade do legado: 10% das chamadas respondem 503.
HELPDESK_FAILURE_RATE=0.1
HELPDESK_MAX_LATENCY_MS=250
HELPDESK_TIMEOUT_MS=2500
HELPDESK_RETRIES=3

# --- Logs ---
# Por padrão o terminal mostra só o essencial (erros, lentidão, turnos do agent).
# LOG_REQUESTS=true   # loga todas as requisições HTTP (depuração)
# LOG_LEVEL=info      # debug | info | warn | error
