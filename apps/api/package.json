{
  "name": "@nexo/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "API do Nexo Assist: autenticação, conversas, agent (Mastra) e console do analista",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "tsx --env-file-if-exists=../../.env src/server.ts",
    "eval": "tsx --env-file-if-exists=../../.env src/eval/run-eval.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/jwt": "^10.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@mastra/core": "^1.81.0",
    "@nexo/shared": "*",
    "fastify": "^5.6.0",
    "zod": "^4.1.0"
  }
}
